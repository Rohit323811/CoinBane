# PayPal Agent Toolkit — sandbox app credentials.
# Create these at https://developer.paypal.com/dashboard/applications/sandbox
# NOTE: use the app's *sandbox* client ID and secret. Live credentials
# authenticate against api-m.paypal.com and are rejected by the sandbox host.
#
# Permissions matter: the read tools fail with HTTP 403
# "insufficient permissions" unless the app has the matching scopes enabled.
# Invoices and disputes work with the defaults; list_transactions requires the
# Transactions/reporting scope to be turned on for the app. Without it, revenue
# analytics returns a permission error rather than data.
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret

# Google Gemini API key — https://aistudio.google.com/apikey
# The @ai-sdk/google provider reads GOOGLE_GENERATIVE_AI_API_KEY by convention;
# lib/config.ts also accepts GEMINI_API_KEY as a fallback.
GEMINI_API_KEY=your-gemini-api-key

# Optional. Overrides the default chat model (gemini-3.8-flash).
#
# Use a Gemini 3 model: the 2.5 family is still listed by the API but is
# rejected for new keys ("no longer available to new users").
#
# Free-tier quotas are per model, so switching IDs is the cheapest way out of a
# rate limit: gemini-3.8-flash allows only 20 requests/day, while the lite
# variants tolerate far more, which a multi-step tool loop needs.
# COINBANE_MODEL_ID=gemini-3.8-flash

# Optional. The name the agent addresses you by in the greeting and prompts.
# Falls back to "Rohit" when unset.
# NEXT_PUBLIC_USER_NAME=Your Name
