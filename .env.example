# PayPal Agent Toolkit — sandbox app credentials.
# Create these at https://developer.paypal.com/dashboard/applications/sandbox
# NOTE: use the app's *sandbox* client ID and secret. Live credentials
# authenticate against api-m.paypal.com and are rejected by the sandbox host.
#
# Permissions matter: the read tools fail with HTTP 403
# "insufficient permissions" unless the app has the matching scopes enabled.
# Invoices and disputes work with the defaults; list_transactions requires the
# Transactions/reporting scope to be turned on for the app. Without it, revenue
# analytics returns a permission error rather than data.
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret

# OpenAI-compatible model access. The first present key wins; the rest are
# ignored, so you can keep several here and swap providers by commenting one out.
#
# Google Gemini (OpenAI-compatible endpoint, no thought-signature proxy).
# Simplest setup: your Google AI Studio key. Requests then go straight to
# Google's OpenAI-compatible endpoint. The value is used exactly as given — no
# format check — so both legacy AIza... keys and the newer AQ.... keys work.
# GEMINI_API_KEY=your-gemini-api-key
#
# Optional: the thought-signature proxy. Gemini 3 rejects tool-calling turns
# whose thought signatures were dropped, and the AI SDK drops them, so this
# proxy re-injects the signatures before forwarding to Google. When set it wins
# over GEMINI_API_KEY. Point it at the proxy's OpenAI-compatible root (no
# trailing /chat/completions):
# GEMINI_PROXY_BASE_URL=your-gemini-proxy-base-url
# Optional. Only needed if your proxy demands its own credential; the Google API
# key lives in the proxy, not here.
# GEMINI_PROXY_API_KEY=your-gemini-proxy-api-key

# Groq (OpenAI-compatible endpoint, free tier, no credit card).
# Free plan on gpt-oss-120b: 30 requests/minute, 1,000 requests/day,
# 8,000 tokens/minute, 200,000 tokens/day, 131K context, 65K max output.
# Get a key at https://console.groq.com/keys — no card required.
# GROQ_API_KEY wins over a bare GEMINI_API_KEY: it is the free plan with a
# published allowance, while a Gemini key that is present but rate-limited
# (HTTP 429) fails every turn. Remove the Groq key to fall back to Google.
GROQ_API_KEY=your-groq-api-key

# Optional. The name the agent addresses you by in the greeting and prompts.
# Falls back to "Rohit" when unset.
# NEXT_PUBLIC_USER_NAME=Your Name
